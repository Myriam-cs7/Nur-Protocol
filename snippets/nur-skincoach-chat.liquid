<!-- ============================================
     NUR PROTOCOL — NUR SKINCOACH CHAT WIDGET
     Rendered site-wide via layout/theme.liquid so the
     AI skincare diagnostic is reachable from any page,
     not just the homepage.

     AVATAR SETUP (Shopify):
     1. Upload your photo to: Shopify Admin > Content > Files
     2. Name the file: nur-skincoach-avatar.jpg
     3. Find the .nur-chat-avatar--photo and .nur-chat-msg__avatar rules below
     4. Add background-image using the asset_url filter and set
        background-size: cover; background-position: center;
     ============================================ -->
<style>
  .nur-chat-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20, 20, 20, 0.70);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .nur-chat-overlay--open {
    opacity: 1;
    pointer-events: all;
  }

  .nur-chat-modal {
    width: 100%;
    max-width: 452px;
    background: #FFFFFF;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    transform: translateY(28px) scale(0.97);
    transition: transform 0.38s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 0 28px 72px rgba(0,0,0,0.32);
  }

  .nur-chat-overlay--open .nur-chat-modal {
    transform: translateY(0) scale(1);
  }

  .nur-chat-header {
    background: #1A1A1A;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .nur-chat-header__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nur-chat-avatar--photo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid rgba(200, 169, 110, 0.6);
    flex-shrink: 0;
    overflow: hidden;
    background: radial-gradient(circle at 50% 38%, #C8A96E 38%, #8A6A3A 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nur-chat-msg__avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.5px solid rgba(200, 169, 110, 0.4);
    flex-shrink: 0;
    overflow: hidden;
    margin-top: 2px;
    background: radial-gradient(circle at 50% 38%, #C8A96E 38%, #8A6A3A 100%);
  }

  .nur-chat-header__name {
    font-size: 14px;
    font-weight: 500;
    color: #FFFFFF;
    letter-spacing: 0.2px;
  }

  .nur-chat-header__status {
    font-size: 11px;
    color: #C8A96E;
    letter-spacing: 0.3px;
    margin-top: 2px;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .nur-chat-header__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #C8A96E;
    animation: nur-pulse 2.2s infinite;
  }

  @keyframes nur-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.35; }
  }

  .nur-chat-close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: rgba(255,255,255,0.38);
    transition: color 0.2s;
    line-height: 0;
  }

  .nur-chat-close:hover { color: #FFFFFF; }
  .nur-chat-close svg {
    width: 18px; height: 18px;
    stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round;
  }

  .nur-chat-progress {
    background: #F5F3EF;
    padding: 8px 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .nur-chat-progress__bar {
    flex: 1; height: 2px;
    background: #E8E4DD; border-radius: 2px; overflow: hidden;
  }

  .nur-chat-progress__fill {
    height: 100%; background: #C8A96E; border-radius: 2px;
    transition: width 0.55s ease; width: 0%;
  }

  .nur-chat-progress__label {
    font-size: 10px; font-weight: 500;
    color: #B8A88A; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap;
  }

  .nur-chat-messages {
    flex: 1; overflow-y: auto;
    padding: 22px 18px 14px;
    display: flex; flex-direction: column; gap: 11px;
    background: #FAFAF8; scroll-behavior: smooth;
  }

  .nur-chat-messages::-webkit-scrollbar { width: 3px; }
  .nur-chat-messages::-webkit-scrollbar-thumb { background: #E0DDD7; border-radius: 2px; }

  .nur-chat-msg {
    display: flex; align-items: flex-start; gap: 9px;
    opacity: 0; animation: nur-msg-in 0.32s ease forwards;
  }

  @keyframes nur-msg-in {
    from { opacity: 0; transform: translateY(9px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .nur-chat-msg__bubble {
    background: #FFFFFF;
    border: 1px solid #ECEAE5;
    border-radius: 0 14px 14px 14px;
    padding: 11px 15px;
    font-size: 14px; font-weight: 400;
    line-height: 1.6; color: #2A2A2A;
    max-width: calc(100% - 42px);
  }

  .nur-chat-reply {
    display: flex; justify-content: flex-end;
    opacity: 0; animation: nur-msg-in 0.32s ease forwards;
  }

  .nur-chat-reply__bubble {
    background: #1A1A1A; color: #FFFFFF;
    border-radius: 14px 14px 0 14px;
    padding: 11px 16px;
    font-size: 13px; font-weight: 400; line-height: 1.5; max-width: 82%;
  }

  .nur-chat-typing {
    display: flex; align-items: center; gap: 9px;
    opacity: 0; animation: nur-msg-in 0.25s ease forwards;
  }

  .nur-chat-typing__dots {
    display: flex; align-items: center; gap: 5px;
    background: #FFFFFF; border: 1px solid #ECEAE5;
    border-radius: 0 14px 14px 14px; padding: 12px 15px;
  }

  .nur-chat-typing__dot {
    width: 6px; height: 6px; border-radius: 50%; background: #C8A96E;
    animation: nur-dot-bounce 1.2s infinite;
  }
  .nur-chat-typing__dot:nth-child(2) { animation-delay: 0.18s; }
  .nur-chat-typing__dot:nth-child(3) { animation-delay: 0.36s; }

  @keyframes nur-dot-bounce {
    0%,60%,100% { transform: translateY(0); opacity: 0.3; }
    30%          { transform: translateY(-5px); opacity: 1; }
  }

  .nur-chat-options {
    padding: 12px 18px 14px;
    display: flex; flex-direction: column; gap: 7px;
    border-top: 1px solid #F0EDE8;
    background: #FFFFFF; flex-shrink: 0;
    max-height: 260px; overflow-y: auto;
  }

  .nur-chat-option {
    background: #FFFFFF;
    border: 1px solid #E8E4DD; border-radius: 3px;
    padding: 11px 15px;
    font-size: 13px; font-weight: 400; color: #3A3A3A;
    cursor: pointer; text-align: left; letter-spacing: 0.1px;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    width: 100%;
  }

  .nur-chat-option:hover {
    border-color: #C8A96E; color: #1A1A1A;
    background: rgba(200,169,110,0.05);
  }

  .nur-chat-option--other {
    color: #9A9A9A; border-style: dashed;
  }
  .nur-chat-option--other:hover { color: #C8A96E; border-color: #C8A96E; border-style: solid; }

  .nur-chat-input-wrap {
    display: flex; align-items: center; gap: 8px;
    background: #FAFAF8; border: 1px solid #E0DDD7;
    border-radius: 3px; padding: 6px 6px 6px 14px;
    transition: border-color 0.2s;
  }

  .nur-chat-input-wrap:focus-within { border-color: #C8A96E; }

  .nur-chat-input {
    flex: 1; border: none; background: transparent;
    font-size: 13px; font-weight: 400; color: #2A2A2A;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    outline: none; padding: 6px 0;
  }

  .nur-chat-input::placeholder { color: #B8B0A4; }

  .nur-chat-input-send {
    width: 34px; height: 34px; border-radius: 3px;
    background: #1A1A1A; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: background 0.2s;
  }

  .nur-chat-input-send:hover { background: #C8A96E; }
  .nur-chat-input-send svg {
    width: 14px; height: 14px;
    stroke: #FFFFFF; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
  }

  .nur-chat-result-wrap {
    opacity: 0; animation: nur-msg-in 0.4s ease 0.1s forwards;
    width: 100%;
  }

  .nur-chat-result {
    background: #1A1A1A; border-radius: 4px; padding: 22px; width: 100%;
  }

  .nur-chat-result__eyebrow {
    font-size: 9px; font-weight: 600; letter-spacing: 3px;
    text-transform: uppercase; color: #C8A96E; margin: 0 0 10px; display: block;
  }

  .nur-chat-result__headline {
    font-size: 15px; font-weight: 300; color: #FFFFFF;
    line-height: 1.45; margin: 0 0 20px; letter-spacing: -0.2px;
  }

  .nur-chat-result__headline em { font-style: italic; color: #C8A96E; }

  .nur-chat-result__priorities {
    display: flex; flex-direction: column; gap: 0;
  }

  .nur-chat-result__priority {
    display: flex; align-items: center; gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }

  .nur-chat-result__priority:last-child { border-bottom: none; }

  .nur-chat-result__priority-num {
    font-size: 11px; font-weight: 600;
    color: #C8A96E; letter-spacing: 1px; width: 20px; flex-shrink: 0;
  }

  .nur-chat-result__priority-name {
    font-size: 13px; font-weight: 400; color: #FFFFFF; flex: 1; letter-spacing: 0.2px;
  }

  .nur-chat-result__priority-lock {
    display: flex; align-items: center;
  }

  .nur-chat-result__priority-lock svg {
    width: 13px; height: 13px;
    stroke: rgba(255,255,255,0.25); fill: none; stroke-width: 1.5; stroke-linecap: round;
  }

  .nur-chat-result__note {
    font-size: 11px; color: rgba(255,255,255,0.35);
    margin: 14px 0 0; letter-spacing: 0.2px; line-height: 1.6;
    border-top: 1px solid rgba(255,255,255,0.07); padding-top: 14px;
  }

  .nur-chat-cta-wrap {
    display: flex; flex-direction: column; gap: 10px;
  }

  .nur-chat-cta {
    display: block; width: 100%;
    padding: 15px 20px; background: #C8A96E; color: #FFFFFF;
    border: none; border-radius: 3px;
    font-size: 12px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase;
    cursor: pointer; text-align: center; text-decoration: none;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    transition: background 0.3s ease;
  }

  .nur-chat-cta:hover { background: #B89558; color: #FFFFFF; }

  .nur-chat-cta-note {
    font-size: 11px; color: #A0A0A0;
    text-align: center; letter-spacing: 0.2px; line-height: 1.65; margin: 0;
  }

  .nur-chat-footer {
    padding: 9px 20px; background: #FFFFFF;
    border-top: 1px solid #F0EDE8;
    font-size: 10px; color: #C8A96E;
    text-align: center; letter-spacing: 3px; text-transform: uppercase; flex-shrink: 0;
  }

  @media (max-width: 500px) {
    .nur-chat-overlay { align-items: flex-end; padding: 0; }
    .nur-chat-modal {
      max-width: 100%; max-height: 93vh;
      border-radius: 12px 12px 0 0;
      transform: translateY(40px);
    }
    .nur-chat-overlay--open .nur-chat-modal { transform: translateY(0); }
  }
</style>

<style>
  .nur-skincoach-fab {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 998;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #1A1A1A;
    color: #FFFFFF;
    border: none;
    border-radius: 999px;
    padding: 14px 22px 14px 16px;
    cursor: pointer;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.28);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .nur-skincoach-fab:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 36px rgba(0,0,0,0.34);
  }

  .nur-skincoach-fab__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #C8A96E;
    flex-shrink: 0;
    animation: nur-pulse 2.2s infinite;
  }

  @media (max-width: 500px) {
    .nur-skincoach-fab {
      bottom: 16px;
      right: 16px;
      padding: 12px 18px 12px 14px;
      font-size: 12px;
    }
  }
</style>

<button class="nur-skincoach-fab" onclick="nurOpenChat()" aria-label="Chat with Nur Skincoach">
  <span class="nur-skincoach-fab__dot"></span>
  Ask Nur Skincoach
</button>

<div class="nur-chat-overlay" id="nurChatOverlay" onclick="nurOverlayClick(event)">
  <div class="nur-chat-modal">

    <div class="nur-chat-header">
      <div class="nur-chat-header__left">
        <div class="nur-chat-avatar--photo"></div>
        <div>
          <div class="nur-chat-header__name">Nur Skincoach</div>
          <div class="nur-chat-header__status">
            <div class="nur-chat-header__status-dot"></div>
            Online now
          </div>
        </div>
      </div>
      <button class="nur-chat-close" onclick="nurCloseChat()" aria-label="Close">
        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="nur-chat-progress">
      <div class="nur-chat-progress__bar">
        <div class="nur-chat-progress__fill" id="nurProgressFill"></div>
      </div>
      <div class="nur-chat-progress__label" id="nurProgressLabel">Step 1 of 4</div>
    </div>

    <div class="nur-chat-messages" id="nurChatMessages"></div>
    <div class="nur-chat-options"  id="nurChatOptions"></div>
    <div class="nur-chat-footer">Dubai &middot; Paris</div>

  </div>
</div>

<script>
(function() {

  var priorityMap = {
    wrinkles:     ['Collagen renewal',    'Firmness & elasticity', 'Deep tissue recovery'],
    pigmentation: ['Tone unification',    'Dark spot control',     'Radiance restoration'],
    acne:         ['Bacterial clearance', 'Pore refinement',       'Inflammation control'],
    dullness:     ['Cellular energising', 'Lymphatic activation',  'Luminosity boost'],
    sensitivity:  ['Barrier repair',      'Redness reduction',     'Soothing response'],
    other:        ['Personalised care',   'Skin balance',          'Targeted recovery']
  };

  var steps = [
    {
      messages: [
        { text: 'Hello. I\'m Nur, your AI Skincoach.',                                                      delay: 500 },
        { text: 'I\'ll ask you 4 quick questions to build your personalised skin routine.',                  delay: 700 },
        { text: 'What is your main skin concern right now?',                                                 delay: 600 }
      ],
      options: [
        { label: 'Fine lines & wrinkles',     key: 'wrinkles'     },
        { label: 'Pigmentation & dark spots', key: 'pigmentation' },
        { label: 'Acne & breakouts',          key: 'acne'         },
        { label: 'Dullness & fatigue',        key: 'dullness'     },
        { label: 'Redness & sensitivity',     key: 'sensitivity'  },
        { label: 'Other',                     key: 'other',      isOther: true, placeholder: 'Describe your skin concern...' }
      ],
      progress: 25
    },
    {
      messages: [
        { text: 'Understood. How would you describe your skin type?', delay: 500 }
      ],
      options: [
        { label: 'Dry',                key: 'dry'        },
        { label: 'Oily',               key: 'oily'       },
        { label: 'Combination',        key: 'combo'      },
        { label: 'Normal or balanced', key: 'normal'     },
        { label: 'Sensitive',          key: 'sens'       },
        { label: 'Other',              key: 'other_type', isOther: true, placeholder: 'Describe your skin type...' }
      ],
      progress: 50
    },
    {
      messages: [
        { text: 'Have you used light therapy before?', delay: 500 }
      ],
      options: [
        { label: 'No, this would be my first time',       key: 'first'     },
        { label: 'Yes, occasionally at a clinic or spa',  key: 'clinic'    },
        { label: 'Yes, I own a home device',              key: 'home'      },
        { label: 'Other',                                 key: 'other_exp', isOther: true, placeholder: 'Tell me more...' }
      ],
      progress: 75
    },
    {
      messages: [
        { text: 'Last question. What is your primary goal with Nur Protocol?', delay: 500 }
      ],
      options: [
        { label: 'Visible results as fast as possible', key: 'fast'      },
        { label: 'A long-term anti-aging approach',     key: 'longterm'  },
        { label: 'A ritual I will genuinely stick to',  key: 'ritual'    },
        { label: 'Other',                               key: 'other_goal', isOther: true, placeholder: 'Share your goal...' }
      ],
      progress: 100
    }
  ];

  var concern  = null;
  var _otherCb = null;

  function getMsgs() { return document.getElementById('nurChatMessages'); }
  function getOpts() { return document.getElementById('nurChatOptions');  }

  function scrollBottom() {
    var m = getMsgs();
    setTimeout(function() { m.scrollTop = m.scrollHeight; }, 60);
  }

  function setProgress(pct, label) {
    document.getElementById('nurProgressFill').style.width = pct + '%';
    document.getElementById('nurProgressLabel').textContent = label;
  }

  function appendNurMsg(text) {
    var el = document.createElement('div');
    el.className = 'nur-chat-msg';
    el.innerHTML = '<div class="nur-chat-msg__avatar"></div><div class="nur-chat-msg__bubble">' + text + '</div>';
    getMsgs().appendChild(el);
    scrollBottom();
  }

  function appendUserMsg(text) {
    var el = document.createElement('div');
    el.className = 'nur-chat-reply';
    el.innerHTML = '<div class="nur-chat-reply__bubble">' + text + '</div>';
    getMsgs().appendChild(el);
    scrollBottom();
  }

  function showTyping() {
    var el = document.createElement('div');
    el.className = 'nur-chat-typing';
    el.id = 'nurTyping';
    el.innerHTML = '<div class="nur-chat-msg__avatar"></div>' +
      '<div class="nur-chat-typing__dots">' +
        '<div class="nur-chat-typing__dot"></div>' +
        '<div class="nur-chat-typing__dot"></div>' +
        '<div class="nur-chat-typing__dot"></div>' +
      '</div>';
    getMsgs().appendChild(el);
    scrollBottom();
  }

  function hideTyping() {
    var t = document.getElementById('nurTyping');
    if (t) t.remove();
  }

  function playMessages(messages, onDone) {
    var i = 0;
    function next() {
      if (i >= messages.length) { if (onDone) onDone(); return; }
      var msg = messages[i++];
      setTimeout(function() {
        showTyping();
        var ms = Math.max(700, Math.min(msg.text.length * 24, 1100));
        setTimeout(function() {
          hideTyping();
          appendNurMsg(msg.text);
          setTimeout(next, i < messages.length ? 200 : 0);
        }, ms);
      }, msg.delay);
    }
    next();
  }

  function renderOptions(options, onSelect) {
    var o = getOpts();
    o.innerHTML = '';
    for (var j = 0; j < options.length; j++) {
      (function(opt) {
        var btn = document.createElement('button');
        btn.className = 'nur-chat-option' + (opt.isOther ? ' nur-chat-option--other' : '');
        btn.textContent = opt.label;
        btn.onclick = function() {
          if (opt.isOther) {
            var ph = opt.placeholder || 'Your answer...';
            showOtherInput(ph, function(val) {
              onSelect({ label: val, key: opt.key, isOther: opt.isOther });
            });
          } else {
            onSelect(opt);
          }
        };
        o.appendChild(btn);
      })(options[j]);
    }
  }

  function showOtherInput(placeholder, onSubmit) {
    window._nurOtherDone = false;
    var o = getOpts();
    o.innerHTML =
      '<div class="nur-chat-input-wrap">' +
        '<input type="text" class="nur-chat-input" id="nurOtherInput"' +
          ' placeholder="' + placeholder + '" maxlength="140" autocomplete="off">' +
        '<button class="nur-chat-input-send" id="nurOtherSend" aria-label="Send">' +
          '<svg viewBox="0 0 24 24">' +
            '<line x1="22" y1="2" x2="11" y2="13"/>' +
            '<polygon points="22 2 15 22 11 13 2 9 22 2"/>' +
          '</svg>' +
        '</button>' +
      '</div>';
    _otherCb = onSubmit;
    var input = document.getElementById('nurOtherInput');
    var send  = document.getElementById('nurOtherSend');
    setTimeout(function() { input.focus(); }, 80);
    input.addEventListener('keydown', function(e) { if (e.key === 'Enter') nurSubmitOther(); });
    send.addEventListener('click', nurSubmitOther);
  }

  window.nurSubmitOther = function() {
    if (window._nurOtherDone) return;
    var input = document.getElementById('nurOtherInput');
    if (!input) return;
    var val = input.value.trim();
    if (!val) return;
    window._nurOtherDone = true;
    getOpts().innerHTML = '';
    if (_otherCb) { _otherCb(val); _otherCb = null; }
  };

  function runStep(idx) {
    var step    = steps[idx];
    var stepNum = idx + 1;
    getOpts().innerHTML = '';
    setProgress(idx === 0 ? 5 : steps[idx - 1].progress, 'Step ' + stepNum + ' of 4');

    playMessages(step.messages, function() {
      setProgress(step.progress, 'Step ' + stepNum + ' of 4');
      renderOptions(step.options, function(opt) {
        if (idx === 0) concern = opt.key;
        getOpts().innerHTML = '';
        appendUserMsg(opt.label);
        if (idx < steps.length - 1) {
          setTimeout(function() { runStep(idx + 1); }, 460);
        } else {
          setTimeout(showResult, 520);
        }
      });
    });
  }

  function showResult() {
    setProgress(100, 'Routine ready');
    var priorities = priorityMap[concern] || priorityMap.other;

    var lockSvg =
      '<svg viewBox="0 0 24 24">' +
        '<rect x="3" y="11" width="18" height="11" rx="2"/>' +
        '<path d="M7 11V7a5 5 0 0 1 10 0v4"/>' +
      '</svg>';

    var prioritiesHtml = '';
    for (var i = 0; i < priorities.length; i++) {
      prioritiesHtml +=
        '<div class="nur-chat-result__priority">' +
          '<span class="nur-chat-result__priority-num">0' + (i + 1) + '</span>' +
          '<span class="nur-chat-result__priority-name">' + priorities[i] + '</span>' +
          '<span class="nur-chat-result__priority-lock">' + lockSvg + '</span>' +
        '</div>';
    }

    showTyping();
    setTimeout(function() {
      hideTyping();
      appendNurMsg('Your skin routine is ready.');

      setTimeout(function() {
        appendNurMsg('Nur has identified <strong>3 priorities</strong> for your skin.');

        setTimeout(function() {
          var wrap = document.createElement('div');
          wrap.className = 'nur-chat-result-wrap';
          wrap.innerHTML =
            '<div class="nur-chat-result">' +
              '<span class="nur-chat-result__eyebrow">Your personalised routine</span>' +
              '<p class="nur-chat-result__headline"><em>3 priorities.</em> Tailored to your skin.</p>' +
              '<div class="nur-chat-result__priorities">' + prioritiesHtml + '</div>' +
              '<p class="nur-chat-result__note">Your complete protocol — light wavelengths, session plan, and skincare sequence — is unlocked inside your Nur Protocol box.</p>' +
            '</div>';
          getMsgs().appendChild(wrap);
          scrollBottom();

          setTimeout(function() {
            getOpts().innerHTML =
              '<div class="nur-chat-cta-wrap">' +
                '<a href="/products/nur-protocol" class="nur-chat-cta">Discover Nur Protocol</a>' +
                '<p class="nur-chat-cta-note">The full Nur Skincoach experience awaits in your box.</p>' +
              '</div>';
          }, 700);
        }, 500);
      }, 600);
    }, 950);
  }

  window.nurOpenChat = function() {
    var overlay = document.getElementById('nurChatOverlay');
    overlay.classList.add('nur-chat-overlay--open');
    document.body.style.overflow = 'hidden';
    concern  = null;
    _otherCb = null;
    getMsgs().innerHTML = '';
    getOpts().innerHTML = '';
    document.getElementById('nurProgressFill').style.width = '0%';
    document.getElementById('nurProgressLabel').textContent = 'Step 1 of 4';
    setTimeout(function() { runStep(0); }, 280);
  };

  window.nurCloseChat = function() {
    document.getElementById('nurChatOverlay').classList.remove('nur-chat-overlay--open');
    document.body.style.overflow = '';
  };

  window.nurOverlayClick = function(e) {
    if (e.target === document.getElementById('nurChatOverlay')) nurCloseChat();
  };

})();
</script>
{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- comment -%}
  Fallback meta descriptions (SEO audit 2026-11-21) for pages that have none in
  Shopify admin: About, Reviews, Contact, the "all" collection and the policies.
  EN/FR like the rest of the theme. A description set in admin always wins.
{%- endcomment -%}
{%- liquid
  assign nur_desc = page_description
  if nur_desc == blank
    assign nur_desc_fr = false
    if request.locale.iso_code == 'fr'
      assign nur_desc_fr = true
    endif
    if page and page.handle == 'about'
      if nur_desc_fr
        assign nur_desc = 'Découvrez Myriam, fondatrice de NŪR Protocol, et l’histoire de NŪR Skincoach : un bilan de peau par IA qui donne une routine LED personnalisée, visage et cou.'
      else
        assign nur_desc = 'Meet Myriam, founder of NŪR Protocol, and the story behind NŪR Skincoach: an AI skin assessment that gives a personalised LED routine for face and neck.'
      endif
    elsif page and page.handle == 'reviews'
      if nur_desc_fr
        assign nur_desc = 'Les avis non retouchés des douze testeurs de NŪR Protocol, le masque LED IA visage et cou, noté 4,6/5.'
      else
        assign nur_desc = 'Unedited reviews from the twelve testers of NŪR Protocol, the AI LED face and neck mask, rated 4.6/5.'
      endif
    elsif page and page.handle == 'contact'
      if nur_desc_fr
        assign nur_desc = 'Contactez NŪR Protocol : commande, routine NŪR Skincoach, livraison ou retours. Chaque message reçoit une réponse personnelle.'
      else
        assign nur_desc = 'Contact NŪR Protocol about your order, your NŪR Skincoach routine, delivery or returns. Every message gets a personal reply.'
      endif
    elsif collection and collection.handle == 'all'
      if nur_desc_fr
        assign nur_desc = 'NŪR Protocol, le masque LED IA visage et cou avec NŪR Skincoach : le bilan de votre peau donne votre routine LED personnalisée.'
      else
        assign nur_desc = 'NŪR Protocol, the AI LED face and neck mask with NŪR Skincoach: your skin assessment gives your personalised LED routine.'
      endif
    elsif request.page_type == 'policy'
      if nur_desc_fr
        assign nur_desc = 'Informations NŪR Protocol : livraison, retours sous 14 jours, garantie 2 ans, confidentialité et conditions de vente.'
      else
        assign nur_desc = 'NŪR Protocol customer information: delivery, 14-day returns, 2-year warranty, privacy and terms of sale.'
      endif
    endif
  endif
-%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = nur_desc | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- comment -%} Skip the brand suffix when the title already names the brand, also with the macron spelling (NŪR) that shop.name ("Nur Protocol") does not match. {%- endcomment -%}
  {%- unless page_title contains shop.name or page_title contains 'NŪR Protocol' %} &ndash; {{ shop.name }}{% endunless -%}
</title>

{%- comment -%}
  Keep thin utility pages out of Google's index (SEO audit 2026-11-21): the
  default "frontpage" collection, the blog while it has no articles, and the
  privacy-choices page. "follow" keeps their links crawlable.
{%- endcomment -%}
{%- liquid
  assign nur_noindex = false
  if collection and collection.handle == 'frontpage'
    assign nur_noindex = true
  endif
  if request.page_type == 'blog' and blog.articles_count == 0
    assign nur_noindex = true
  endif
  if page and page.handle == 'data-sharing-opt-out'
    assign nur_noindex = true
  endif
-%}
{%- if nur_noindex -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if nur_desc != blank %}
  <meta
    name="description"
    content="{{ nur_desc | escape }}"
  >
{% endif %}

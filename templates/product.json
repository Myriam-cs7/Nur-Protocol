larna' | payment_type_svg_tag: class: 'nur-pay__klarna-icon' -%}\n  {%- if cart.currency.iso_code == 'EUR' -%}\n    {%- if request.locale.iso_code == 'fr' -%}\n      {%- capture nur_third_label -%}{{ nur_third | money_without_currency | remove: ',00' | remove: '.00' }}\u20ac{%- endcapture -%}\n      <p class=\"nur-pay__klarna\">Ou en <strong>3 pr\u00e9l\u00e8vements mensuels de {{ nur_third_label }}</strong> avec {{ nur_klarna_icon }}</p>\n    {%- else -%}\n      <p class=\"nur-pay__klarna\">Or <strong>3 monthly payments of {{ nur_third | money_without_trailing_zeros }}</strong> with {{ nur_klarna_icon }}</p>\n    {%- endif -%}\n  {%- else -%}\n    <p class=\"nur-pay__klarna\">{% if request.locale.iso_code == 'fr' %}Payez en plusieurs fois avec{% else %}Pay over time with{% endif %} {{ nur_klarna_icon }}</p>\n  {%- endif -%}\n  <ul class=\"nur-pay__icons\" role=\"list\" aria-label=\"Accepted payment methods\">\n    {%- assign nur_pay_types = 'shopify_pay,apple_pay,paypal,visa,master,american_express,cartes_bancaires,klarna' | split: ',' -%}\n    {%- for nur_pay_type in nur_pay_types -%}\n      <li>{{ nur_pay_type | payment_type_svg_tag: class: 'nur-pay__icon' }}</li>\n    {%- endfor -%}\n  </ul>\n</div>\n<style>\n  .nur-pay { margin-top: 4px; }\n  .nur-pay__klarna { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; font-size: 14px; color: #1A1A1A; }\n  .nur-pay__klarna strong { font-weight: 600; }\n  .nur-pay__klarna-icon { width: auto; height: 20px; display: block; }\n  .nur-pay__icons { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }\n  .nur-pay__icons li { display: flex; }\n  .nur-pay__icon { width: 38px; height: 24px; display: block; }\n</style>"},"blocks":{}}},"block_order":["depo_subscription_block_Qn87iR","group_icgrde","variant_picker_R3rGDr","text_precommande","buy_buttons_eYQEYi","custom_liquid_payment","text_aEtTtq"]}},"settings":{"content_width":"content-center-aligned","desktop_media_po
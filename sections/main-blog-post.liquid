

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section color-{{ section.settings.color_scheme }}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
      nur-article
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {%- liquid
      assign nur_fr = false
      if request.locale.iso_code == 'fr'
        assign nur_fr = true
      endif
      assign nur_pdp = routes.root_url | append: '/products/nur-protocol' | replace: '//', '/'
    -%}
    <header>
      <a class="nur-article__eyebrow" href="{{ blog.url }}">{{ blog.title }}</a>
      {%- content_for 'block', id: 'blog-post-title', type: 'text' %}
      {%- content_for 'block', id: 'blog-post-details', type: '_blog-post-info-text' %}
    </header>

    {%- if article.image -%}
      {%- content_for 'block', id: 'blog-post-image', type: '_blog-post-featured-image' %}
    {%- endif -%}
    {%- content_for 'block', id: 'blog-post-content', type: '_blog-post-content' %}

    <aside class="nur-article__cta">
      <span class="nur-article__cta-eyebrow">NŪR Protocol</span>
      <p class="nur-article__cta-title">{% if nur_fr %}Le masque LED visage et cou, guidé par NŪR Skincoach{% else %}The LED face and neck mask, guided by NŪR Skincoach{% endif %}</p>
      <p class="nur-article__cta-text">{% if nur_fr %}Le bilan de votre peau donne votre routine personnalisée, semaine après semaine.{% else %}Your skin assessment gives your personalised routine, week after week.{% endif %}</p>
      <a class="nur-article__cta-button" href="{{ nur_pdp }}">{% if nur_fr %}Découvrir NŪR Protocol{% else %}Discover NŪR Protocol{% endif %}</a>
    </aside>

    {% comment %} Dynamic area for @app blocks only, at the bottom {% endcomment %}
    {% content_for 'blocks' %}

    {% if blog.comments_enabled? %}
      <div class="blog-post-comments-container">
        <h2 class="h3">{{- 'blogs.article.comments_heading' | t: count: article.comments_count -}}</h2>

        <div class="blog-post-comments">
          {% paginate article.comments by 10 %}
            {% for comment in article.comments %}
              <div class="blog-post-comment">
                {{ comment.content }}
                <div class="blog-post-comment__author">
                  <span class="blog-post-comment__author-name">{{- comment.author -}}</span>
                  <span>{{- 'blogs.article.comment_author_separator' | t -}}</span>
                  <span class="blog-post-comment__date">
                    {{- comment.created_at | time_tag: format: 'date' -}}
                  </span>
                </div>
              </div>
            {% endfor %}

            <div class="blog-post-comments-pagination">
              {{- paginate | default_pagination -}}
            </div>
          {% endpaginate %}
        </div>

        {% render 'blog-comment-form', article: article, section_id: section.id %}
      </div>
    {% endif %}
  </div>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>


{%- comment -%}
  Journal article layout in the NŪR design system (user feedback 2026-11-21: the
  default Horizon article looked off-brand, with a huge image and bulleted text).
{%- endcomment -%}
<style>
  .nur-article { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1A1A1A; }
  .nur-article header { max-width: 820px; margin: 0 auto; text-align: center; }
  .nur-article__eyebrow { display: inline-block; margin-bottom: 18px; font-size: 11px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; color: #C8A96E; text-decoration: none; }
  .nur-article header h1 { margin: 0; font-family: inherit; font-size: clamp(28px, 3.2vw, 40px); font-weight: 500; line-height: 1.2; letter-spacing: -0.4px; color: #1A1A1A; text-wrap: balance; }
  .nur-article .blog-post-details { margin-top: 18px; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #8A8A8A; }
  .nur-article .blog-post-featured-image { width: 100%; max-width: 880px; height: auto; margin: 8px auto 0; aspect-ratio: 3 / 2; overflow: hidden; }
  .nur-article .blog-post-featured-image__image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 28%; }
  .nur-article .blog-post-content.rte { max-width: 680px; margin: 16px auto 0; font-family: inherit; font-size: 17px; line-height: 1.8; color: #3A3A3A; }
  .nur-article .blog-post-content.rte p { margin: 0 0 22px; }
  .nur-article .blog-post-content.rte h2 { margin: 56px 0 18px; font-family: inherit; font-size: 24px; font-weight: 500; line-height: 1.3; letter-spacing: -0.2px; color: #1A1A1A; }
  .nur-article .blog-post-content.rte a { color: #1A1A1A; text-decoration: underline; text-decoration-color: #C8A96E; text-underline-offset: 3px; }
  .nur-article .blog-post-content.rte strong { font-weight: 600; color: #1A1A1A; }
  .nur-article .blog-post-content.rte .nur-article__lead { font-size: 20px; line-height: 1.6; color: #1A1A1A; margin-bottom: 8px; }
  .nur-article .blog-post-content.rte .nur-article__figure { margin: 36px 0; }
  .nur-article .blog-post-content.rte .nur-article__figure img { display: block; width: 100%; height: auto; margin: 0; }
  .nur-article .blog-post-content.rte .nur-article__figure figcaption { margin-top: 12px; font-size: 13px; line-height: 1.6; color: #8A8A8A; text-align: center; }
  .nur-article .blog-post-content.rte .nur-article__faq { margin-top: 8px; border-top: 1px solid #E4DFD5; }
  .nur-article .blog-post-content.rte details { border-bottom: 1px solid #E4DFD5; }
  .nur-article .blog-post-content.rte summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 20px 0; cursor: pointer; font-size: 16px; font-weight: 600; color: #1A1A1A; }
  .nur-article .blog-post-content.rte summary::-webkit-details-marker { display: none; }
  .nur-article .blog-post-content.rte summary::after { content: '+'; font-size: 20px; font-weight: 300; color: #C8A96E; }
  .nur-article .blog-post-content.rte details[open] summary::after { content: '\2212'; }
  .nur-article .blog-post-content.rte details p { margin: 0 0 22px; font-size: 16px; }
  .nur-article .blog-post-content.rte .nur-article__sources { margin-top: 64px; padding-top: 24px; border-top: 1px solid #E4DFD5; }
  .nur-article .blog-post-content.rte .nur-article__sources p { margin: 0 0 10px; font-size: 13px; line-height: 1.6; color: #8A8A8A; }
  .nur-article .blog-post-content.rte .nur-article__sources .nur-article__sources-title { margin-bottom: 14px; font-size: 11px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; color: #C8A96E; }
  .nur-article .blog-post-content.rte .nur-article__note { margin-top: 32px; font-size: 13px; line-height: 1.6; color: #8A8A8A; }
  .nur-article__cta { width: 100%; max-width: 680px; margin: 24px auto 0; padding: 40px; background: #FAFAF8; border-top: 1px solid #C8A96E; text-align: center; box-sizing: border-box; }
  .nur-article__cta-eyebrow { display: block; margin-bottom: 12px; font-size: 11px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; color: #C8A96E; }
  .nur-article__cta-title { margin: 0 0 8px; font-size: 22px; font-weight: 500; line-height: 1.3; color: #1A1A1A; }
  .nur-article__cta-text { margin: 0 0 24px; font-size: 15px; line-height: 1.6; color: #4A4A4A; }
  .nur-article__cta-button { display: inline-block; padding: 16px 32px; background: #1A1A1A; color: #FFFFFF; font-size: 12px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; text-decoration: none; transition: background .25s ease, color .25s ease; }
  .nur-article__cta-button:hover { background: #C8A96E; color: #1A1A1A; }
  @media (max-width: 749px) {
    .nur-article .blog-post-content.rte { font-size: 16px; }
    .nur-article .blog-post-content.rte .nur-article__lead { font-size: 18px; }
    .nur-article .blog-post-content.rte h2 { margin-top: 44px; font-size: 21px; }
    .nur-article__cta { padding: 32px 24px; }
  }
</style>

{%- comment -%} Breadcrumb for Google (SEO plan 2026-11-21): Home › blog › article. {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ shop.name | json }}, "item": {{ request.origin | append: routes.root_url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
    ]
  }
</script>

{% stylesheet %}
  .blog-post-comments-container {
    width: 100%;
    max-width: var(--normal-content-width);
    margin: 0 auto;
  }

  .blog-post-comments {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xl);
  }

  .blog-post-comment__author {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
    margin-top: var(--margin-md);
    font-size: var(--font-size--body-sm);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-comments-pagination {
    display: flex;
    justify-content: center;
    gap: var(--gap-2xs);
  }

  .blog-post-comments-pagination,
  .blog-post-comments-pagination a {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current {
    color: var(--color-foreground);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a {
    display: block;
    padding: var(--padding-2xs) var(--padding-xs);
  }

  .blog-post-comments-pagination .current,
  .blog-post-comments-pagination a:hover {
    border-bottom: 1px solid var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "class": "section-wrapper",
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
